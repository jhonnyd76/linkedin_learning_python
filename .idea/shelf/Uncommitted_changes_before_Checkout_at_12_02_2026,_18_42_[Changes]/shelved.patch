@@ -1,4 +1,6 @@
 #!/usr/bin/env python3
+import operator
+from nis import match
 
 # Aufgabe: Programmieren Sie einen einfachen Taschenrechner
 
@@ -18,3 +20,22 @@
 # 4. Das Programm führt die Berechnung durch und gibt das Ergebnis aus.
 
 # Optional: Erweitern Sie den Taschenrechner um weitere Funktionen wie Potenzierung oder Modulo.
+
+operators ={
+    "+": operator.add,
+    "-": operator.sub,
+    "*": operator.mul,
+    "/": operator.truediv,
+    "%": operator.mod,
+    "^": operator.pow,
+}
+for i in range(1, 10):
+    zahl1 = float(input("Geben sie die erste Zahl ein: "))
+    zahl2 = float(input("Geben sie die zweite Zahl ein: "))
+    symbol = input("Wählen sie welche Rechenoperatin sie durchführen wollen: [+,-,*,/,%,^]! ")
+
+    result = operators[symbol](zahl1, zahl2)
+    print(f"Das Ergebnis der Berechnung {zahl1} {symbol} {zahl2} ist {result}!")
+
+
+
